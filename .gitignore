*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.brf
*.blg
*.bcf
*.run.xml
*.synctex.*
*.tmp

# Build products: PDFs are built by CI, not stored in git -- except figure
# inputs such as the one below. (plan.html section 4 assumed no figure PDFs
# existed; 1110.0466v3/dilognotes.tex includes QKHKcorrespondence3 as a
# figure, so it stays tracked.)
*.pdf
!1110.0466v3/QKHKcorrespondence3.pdf

# Python bytecode
__pycache__/
