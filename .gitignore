# Sources are tracked; build products are not (see plan.html, section 4).
# The PDFs readers download are produced by CI (section 5).

# LaTeX intermediates
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.brf
*.blg
*.bcf
*.run.xml
*.synctex.*
*.tmp
*.idx
*.ilg
*.ind

# Build products: PDFs are built by CI, not stored in git. A paper that
# uses a PDF as a figure input re-tracks it with a negation in its own
# directory .gitignore (see 1110.0466v3/.gitignore), keeping the exception
# scoped to that paper.
*.pdf

# Python bytecode
__pycache__/
